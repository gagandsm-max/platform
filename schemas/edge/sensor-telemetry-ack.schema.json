{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/edge/sensor-telemetry-ack.schema.json",
  "title": "Sensor→Core Telemetry ACK v1",
  "description": "CURRENT_IMPLEMENTED_V1 TelemetryAckResponse. Exact snake_case ACK fields (B000-D003). No batchId/correlationId on this ACK.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "accepted_through_sequence", "sensor_identity"],
  "properties": {
    "status": {"type": "string", "minLength": 1, "maxLength": 64},
    "accepted_through_sequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "sensor_identity": {"$ref": "common-definitions.schema.json#/$defs/sensorId"}
  }
}
