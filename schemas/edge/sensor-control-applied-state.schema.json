{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/edge/sensor-control-applied-state.schema.json",
  "title": "Sensor→Core Control Applied-State ACK Request v1",
  "description": "BUILD-004 Slice 2 machine PUT /api/v1/sensor/control/applied-state request. No tenantId/sensorId/actor fields. Identity is mTLS-derived. Unknown properties forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "checksum", "outcome"],
  "properties": {
    "schemaVersion": {"$ref": "common-definitions.schema.json#/$defs/schemaVersionV1"},
    "generation": {"$ref": "common-definitions.schema.json#/$defs/controlCounterPositive"},
    "checksum": {"$ref": "#/$defs/checksumSha256HexLower"},
    "outcome": {"type": "string", "enum": ["APPLIED", "REJECTED"]},
    "rejectionCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "rejectionMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "$defs": {
    "checksumSha256HexLower": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "description": "BUILD-004 Slice 2 Sensor-control SHA-256 lowercase hex only (matches Core runtime and V014)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "REJECTED"}},
        "required": ["outcome"]
      },
      "then": {
        "required": ["rejectionCode"]
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "APPLIED"}},
        "required": ["outcome"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["rejectionCode"]},
            {"required": ["rejectionMessage"]}
          ]
        }
      }
    }
  ]
}
