{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_agents/schemas/task_manifest.schema.json",
  "title": "Platform Control Plane v2 Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "taskType",
    "objective",
    "repository",
    "authoritativeMain",
    "branch",
    "worktree",
    "governingRequirements",
    "selectedAgents",
    "selectedSkills",
    "scope",
    "nonGoals",
    "securityBoundaries",
    "migrationReservations",
    "dependencies",
    "requiredTests",
    "requiredEvidence",
    "stopConditions",
    "writerTool",
    "verifierTool",
    "gatekeeper",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "v2", "type": "string"},
    "taskId": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "taskType": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "authoritativeMain": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "exactHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "governingRequirements": {"type": "array", "items": {"type": "string"}},
    "selectedAgents": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true},
    "selectedSkills": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
    "scope": {"type": "array", "items": {"type": "string"}},
    "nonGoals": {"type": "array", "items": {"type": "string"}},
    "securityBoundaries": {"type": "array", "items": {"type": "string"}},
    "migrationReservations": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "requiredTests": {"type": "array", "items": {"type": "string"}},
    "requiredEvidence": {"type": "array", "items": {"type": "string"}},
    "stopConditions": {"type": "array", "items": {"type": "string"}},
    "writerTool": {
      "type": "string",
      "enum": ["cursor-cli", "codex", "antigravity", "github-copilot"],
      "description": "Policy-eligible bounded writer. Cursor CLI is the default. Explicit scope and verified source are required for dispatch."
    },
    "writerElevation": {
      "type": "null",
      "description": "Reserved field. Omit it or set it to null. A task manifest does not confer execution authority."
    },
    "verifierTool": {
      "type": "string",
      "enum": ["chatgpt-github", "antigravity", "cursor-cli", "codex", "github-copilot"],
      "description": "Independent peer reviewer from a different tool family. Gate and certification authority are separate."
    },
    "gatekeeper": {
      "type": "string",
      "enum": ["chatgpt-github", "founder"],
      "description": "Control-plane gatekeeper. Must differ from writerTool. Writers cannot self-certify. Derived from project_agents/tool_authority.json."
    },
    "status": {
      "type": "string",
      "enum": [
        "INTAKE",
        "REBASELINE",
        "REQUIREMENTS",
        "DIAGNOSIS",
        "ROUTING",
        "IMPLEMENTATION",
        "LOCAL_VALIDATION",
        "SOURCE_REVIEW",
        "ADVERSARIAL_RUNTIME",
        "SECURITY_DOMAIN_REVIEW",
        "CI_VALIDATION",
        "REALITY_GATE",
        "MERGE_READY",
        "POST_MERGE_VERIFY",
        "COMPLETE",
        "BLOCKED",
        "REJECTED"
      ]
    },
    "createdAt": {"type": "string", "minLength": 1},
    "updatedAt": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "not": {
        "properties": {"writerTool": {"const": "cursor-cli"}, "verifierTool": {"const": "cursor-cli"}},
        "required": ["writerTool", "verifierTool"]
      }
    },
    {
      "not": {
        "properties": {"writerTool": {"const": "codex"}, "verifierTool": {"const": "codex"}},
        "required": ["writerTool", "verifierTool"]
      }
    },
    {
      "not": {
        "properties": {"writerTool": {"const": "antigravity"}, "verifierTool": {"const": "antigravity"}},
        "required": ["writerTool", "verifierTool"]
      }
    },
    {
      "not": {
        "properties": {"writerTool": {"const": "github-copilot"}, "verifierTool": {"const": "github-copilot"}},
        "required": ["writerTool", "verifierTool"]
      }
    }
  ]
}
