# ==============================================================================
# Platform Engineering Environment Configuration (.env.example)
# Clean-room development configuration. Copy to .env before starting services.
# DO NOT commit .env with real credentials into version control.
# ==============================================================================

# Compose Project Settings
COMPOSE_PROJECT_NAME=platform
COMPOSE_PROFILES=dev

# Environment / Node Identity
PLATFORM_ENV=development
PLATFORM_VERSION=0.1.0-dev
PLATFORM_LOG_LEVEL=INFO
CORE_NODE_ID=core-node-01
SENSOR_NETWORK_ID=sensor-net-01
SENSOR_INFRA_ID=sensor-infra-01

# Host Port Mappings (Binds to 127.0.0.1 to prevent external exposure)
# Non-conflicting dev port range (20000-29999)
PLATFORM_CORE_HOST_PORT=28443
PLATFORM_UI_HOST_PORT=23000
PLATFORM_POSTGRES_HOST_PORT=25432
PLATFORM_CLICKHOUSE_HTTP_HOST_PORT=28123
PLATFORM_CLICKHOUSE_NATIVE_HOST_PORT=29000
PLATFORM_VALKEY_HOST_PORT=26379

# PostgreSQL Configuration (Authoritative Transactional Store)
POSTGRES_DB=platform
POSTGRES_USER=platform_app
POSTGRES_PASSWORD=platform_dev_pg_password_change_in_prod

# ClickHouse Configuration (High-Volume Telemetry / Analytics)
CLICKHOUSE_DB=platform
CLICKHOUSE_USER=platform_app
CLICKHOUSE_PASSWORD=platform_dev_ch_password_change_in_prod

# Valkey Configuration (Cache / Ephemeral State)
VALKEY_PASSWORD=platform_dev_valkey_password_change_in_prod

# Kafka Configuration (Internal Streaming Backbone - Not Exposed to Host)
KAFKA_CLUSTER_ID=PlatformKafkaDevCluster001
KAFKA_KRAFT_BROKER_ID=1

# Guarded storage is staged, explicit opt-in only (Compose 5.5.0).
# Existing installations MUST complete the cold migration/cutover runbook first.
# For an intentionally NEW deployment, retain unique values then explicitly provision.
# COMPOSE_FILE=compose.yaml:compose.kafka-guarded.yaml
# PLATFORM_KAFKA_DATA_VOLUME=<unique-new-volume-name>
# PLATFORM_KAFKA_CLUSTER_ID=<new-Kafka-UUID-or-actual-migrated-stored-ID>
# PLATFORM_KAFKA_STORAGE_ID=<independently-retained-unique-identity>
# PLATFORM_KAFKA_NEW_VOLUME_CONFIRM is an explicit shell authorization, not a default.
