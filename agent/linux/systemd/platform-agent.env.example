# Platform Linux Agent environment. Install as /etc/platform/agent.env with mode 0600.
# systemd EnvironmentFile is required; a missing file fails the unit (fail-closed).
# Do not put private key material in this file; reference filesystem paths only.
# The platform-agent user and group are created by the Linux package.

PLATFORM_AGENT_TENANT_ID=
PLATFORM_AGENT_ID=
PLATFORM_AGENT_SENSOR_URL=https://sensor-infra.example.invalid:8443
# Optional Core origin for future enrollment/control. Never used for telemetry.
# PLATFORM_AGENT_CORE_URL=https://core.example.invalid:8443
PLATFORM_AGENT_CA_FILE=/etc/platform/agent/ca.crt
PLATFORM_AGENT_CERT_FILE=/etc/platform/agent/agent.crt
PLATFORM_AGENT_KEY_FILE=/etc/platform/agent/agent.key
PLATFORM_AGENT_STATE_DIR=/var/lib/platform/agent
PLATFORM_AGENT_HEALTH_ADDRESS=127.0.0.1:8089
PLATFORM_LOG_LEVEL=INFO
