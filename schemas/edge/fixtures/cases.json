{
  "examples": {
    "agentBatch": "examples/agent-telemetry-batch.json",
    "agentBatchMax": "examples/agent-telemetry-batch-max-safe-sequence.json",
    "agentAck": "examples/agent-telemetry-ack.json",
    "sensorBatch": "examples/sensor-telemetry-batch.json",
    "sensorAck": "examples/sensor-telemetry-ack.json",
    "ingressBatch": "examples/sensor-agent-ingress-batch.json",
    "ingressAck": "examples/sensor-agent-ingress-ack.json",
    "hbReq": "examples/sensor-heartbeat-request.json",
    "hbResp": "examples/sensor-heartbeat-response.json",
    "stdErr": "examples/standard-error.json"
  },
  "cases": [
    {"name": "valid-agent-batch", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": true},
    {"name": "valid-agent-batch-max-safe-sequence", "base": "agentBatchMax", "schema": "agent-telemetry-batch", "valid": true},
    {"name": "valid-agent-ack", "base": "agentAck", "schema": "agent-telemetry-ack", "valid": true, "submitted": "agentBatch"},
    {"name": "valid-sensor-batch", "base": "sensorBatch", "schema": "sensor-telemetry-batch", "valid": true},
    {"name": "valid-sensor-ack", "base": "sensorAck", "schema": "sensor-telemetry-ack", "valid": true, "submitted": "sensorBatch"},
    {"name": "valid-ingress-batch", "base": "ingressBatch", "schema": "sensor-agent-ingress-batch", "valid": true},
    {"name": "valid-ingress-ack", "base": "ingressAck", "schema": "sensor-agent-ingress-ack", "valid": true, "submitted": "ingressBatch"},
    {"name": "valid-heartbeat-request", "base": "hbReq", "schema": "sensor-heartbeat-request", "valid": true},
    {"name": "valid-heartbeat-response", "base": "hbResp", "schema": "sensor-heartbeat-response", "valid": true},
    {"name": "valid-standard-error", "base": "stdErr", "schema": "standard-error", "valid": true},

    {"name": "sequence-zero", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_OUT_OF_BOUNDS"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": 0}, {"op": "set", "path": ["lastSequence"], "value": 0}, {"op": "set", "path": ["records", 0, "sequence"], "value": 0}]},
    {"name": "sequence-above-max-safe", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_NOT_SAFE_INTEGER"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": 9007199254740992}, {"op": "set", "path": ["lastSequence"], "value": 9007199254740992}, {"op": "set", "path": ["records", 0, "sequence"], "value": 9007199254740992}]},
    {"name": "sequence-negative", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_OUT_OF_BOUNDS"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": -1}, {"op": "set", "path": ["lastSequence"], "value": -1}, {"op": "set", "path": ["records", 0, "sequence"], "value": -1}]},
    {"name": "sequence-fractional", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_FRACTIONAL"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": 1.5}, {"op": "set", "path": ["lastSequence"], "value": 1.5}, {"op": "set", "path": ["records", 0, "sequence"], "value": 1.5}]},
    {"name": "sequence-numeric-string", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_TYPE_INVALID"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": "1"}, {"op": "set", "path": ["lastSequence"], "value": "1"}, {"op": "set", "path": ["records", 0, "sequence"], "value": "1"}]},
    {"name": "unsupported-schema-version", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["UNSUPPORTED_SCHEMA_VERSION"], "mutations": [{"op": "set", "path": ["schemaVersion"], "value": 2}]},
    {"name": "missing-required-identity", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["MISSING_REQUIRED_FIELD"], "mutations": [{"op": "delete", "path": ["agentId"]}]},
    {"name": "malformed-sensor-stream-id", "base": "sensorBatch", "schema": "sensor-telemetry-batch", "valid": false, "expectedCodes": ["INVALID_SENSOR_STREAM_ID"], "mutations": [{"op": "set", "path": ["bootEpoch"], "value": "boot-1"}]},
    {"name": "wrong-agent-ack-casing", "base": "agentAck", "schema": "agent-telemetry-ack", "valid": false, "expectedCodes": ["UNKNOWN_FIELD", "MISSING_REQUIRED_FIELD"], "mutations": [{"op": "delete", "path": ["accepted_through_sequence"]}, {"op": "set", "path": ["acceptedThroughSequence"], "value": 1}]},
    {"name": "wrong-ingress-ack-casing", "base": "ingressAck", "schema": "sensor-agent-ingress-ack", "valid": false, "expectedCodes": ["UNKNOWN_FIELD", "MISSING_REQUIRED_FIELD"], "mutations": [{"op": "delete", "path": ["acceptedThroughIngressSequence"]}, {"op": "set", "path": ["accepted_through_sequence"], "value": 1}]},
    {"name": "ack-below-first", "base": "agentAck", "schema": "agent-telemetry-ack", "valid": false, "expectedCodes": ["ACK_BELOW_FIRST", "SEQUENCE_OUT_OF_BOUNDS"], "submitted": {"firstSequence": 5, "lastSequence": 10}, "mutations": [{"op": "set", "path": ["accepted_through_sequence"], "value": 0}]},
    {"name": "ack-below-first-sensor", "base": "sensorAck", "schema": "sensor-telemetry-ack", "valid": false, "expectedCodes": ["ACK_BELOW_FIRST"], "submitted": {"firstSequence": 5, "lastSequence": 10}, "mutations": [{"op": "set", "path": ["accepted_through_sequence"], "value": 4}]},
    {"name": "ack-above-last", "base": "sensorAck", "schema": "sensor-telemetry-ack", "valid": false, "expectedCodes": ["ACK_ABOVE_LAST"], "submitted": "sensorBatch", "mutations": [{"op": "set", "path": ["accepted_through_sequence"], "value": 99}]},
    {"name": "first-gt-last", "base": "sensorBatch", "schema": "sensor-telemetry-batch", "valid": false, "expectedCodes": ["SEQUENCE_BOUNDS_INVALID"], "mutations": [{"op": "set", "path": ["firstSequence"], "value": 5}, {"op": "set", "path": ["lastSequence"], "value": 2}]},
    {"name": "record-count-mismatch", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["RECORD_COUNT_MISMATCH"], "mutations": [{"op": "set", "path": ["recordCount"], "value": 2}]},
    {"name": "duplicate-sequence", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["DUPLICATE_SEQUENCE"], "mutations": [{"op": "set", "path": ["recordCount"], "value": 2}, {"op": "set", "path": ["lastSequence"], "value": 1}, {"op": "set", "path": ["records"], "value": [{"sequence": 1, "id": "rec-1", "createdAt": "2026-09-24T10:00:00.000Z", "checksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "payload": {}}, {"sequence": 1, "id": "rec-2", "createdAt": "2026-09-24T10:00:00.000Z", "checksum": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "payload": {}}]}]},
    {"name": "checksum-invalid", "base": "sensorBatch", "schema": "sensor-telemetry-batch", "valid": false, "expectedCodes": ["INVALID_CHECKSUM"], "mutations": [{"op": "set", "path": ["checksum"], "value": "not-a-checksum"}]},
    {"name": "timestamp-not-utc-z", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["INVALID_UTC_TIMESTAMP"], "mutations": [{"op": "set", "path": ["records", 0, "createdAt"], "value": "2026-09-24T10:00:00+05:30"}]},
    {"name": "unknown-field", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["UNKNOWN_FIELD"], "mutations": [{"op": "set", "path": ["unexpected"], "value": true}]},
    {"name": "secret-bearing-field", "base": "agentBatch", "schema": "agent-telemetry-batch", "valid": false, "expectedCodes": ["FORBIDDEN_SECRET_FIELD"], "mutations": [{"op": "set", "path": ["records", 0, "payload", "password"], "value": "fictional"}]},
    {"name": "heartbeat-response-desired-state-forbidden", "base": "hbResp", "schema": "sensor-heartbeat-response", "valid": false, "expectedCodes": ["UNKNOWN_FIELD"], "mutations": [{"op": "set", "path": ["desiredConfigVersion"], "value": 7}, {"op": "set", "path": ["assignmentVersion"], "value": 9}]},
    {"name": "standard-error-missing-code", "base": "stdErr", "schema": "standard-error", "valid": false, "expectedCodes": ["MISSING_REQUIRED_FIELD"], "mutations": [{"op": "delete", "path": ["code"]}]}
  ]
}
