{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/edge/sensor-agent-ingress-batch.schema.json",
  "title": "Sensor→Core Agent-Ingress Batch",
  "description": "BUILD-003 contract: schemaVersion 2 requires sensorAgentSpoolStreamId (Sensor Agent DiskSpool stream). schemaVersion 1 retained as historical evidence only; production path is v2. Outer sensorIngressSequence uses complete unordered set semantics. Nested records[] are original Agent DeliveryRecord arrays. Sequence ceiling FROZEN_BUILD_000_INVARIANT with BUILD-003 runtime enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sensorId", "batchId", "firstIngressSequence", "lastIngressSequence", "recordCount", "checksum", "correlationId", "records"],
  "properties": {
    "schemaVersion": {
      "oneOf": [
        {"$ref": "common-definitions.schema.json#/$defs/schemaVersionV1"},
        {"$ref": "common-definitions.schema.json#/$defs/schemaVersionV2"}
      ]
    },
    "sensorId": {"$ref": "common-definitions.schema.json#/$defs/sensorId"},
    "sensorAgentSpoolStreamId": {"$ref": "common-definitions.schema.json#/$defs/sensorStreamId"},
    "batchId": {"$ref": "common-definitions.schema.json#/$defs/coreBatchId"},
    "firstIngressSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "lastIngressSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "recordCount": {"type": "integer", "minimum": 1, "maximum": 1000},
    "checksum": {"$ref": "common-definitions.schema.json#/$defs/checksumSha256Hex"},
    "correlationId": {"$ref": "common-definitions.schema.json#/$defs/correlationId"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensorIngressSequence",
          "sensorIngressRecordId",
          "tenantId",
          "agentId",
          "acceptingSensorId",
          "assignmentGeneration",
          "agentFirstSequence",
          "agentLastSequence",
          "agentBatchId",
          "correlationId",
          "acceptedAt",
          "records"
        ],
        "properties": {
          "sensorIngressSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
          "sensorIngressRecordId": {"$ref": "common-definitions.schema.json#/$defs/opaqueRecordId"},
          "tenantId": {"$ref": "common-definitions.schema.json#/$defs/tenantId"},
          "agentId": {"$ref": "common-definitions.schema.json#/$defs/agentId"},
          "acceptingSensorId": {"$ref": "common-definitions.schema.json#/$defs/sensorId"},
          "assignmentGeneration": {"$ref": "common-definitions.schema.json#/$defs/controlCounterPositive"},
          "agentFirstSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
          "agentLastSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
          "agentBatchId": {"$ref": "common-definitions.schema.json#/$defs/agentDeliveryBatchId"},
          "correlationId": {"$ref": "common-definitions.schema.json#/$defs/correlationId"},
          "acceptedAt": {"$ref": "common-definitions.schema.json#/$defs/utcTimestamp"},
          "acceptanceEvidence": {
            "type": "object",
            "additionalProperties": false,
            "description": "SensorAcceptanceEvidenceV1. The Core enforces acceptedAtUtc=acceptedAt and durableSpoolSequence=sensorIngressSequence. Absent evidence is historical pre-evidence data and cannot qualify revoked authority.",
            "required": ["evidenceVersion", "acceptedAtUtc", "clockQuality", "clockSource", "sensorServiceInstanceId", "durableSpoolSequence"],
            "properties": {
              "evidenceVersion": {"const": 1},
              "acceptedAtUtc": {"$ref": "common-definitions.schema.json#/$defs/utcTimestamp"},
              "clockQuality": {"enum": ["QUALIFIED", "UNQUALIFIED"]},
              "clockMaxErrorMs": {"type": "integer", "minimum": 0, "maximum": 5000},
              "clockSyncAgeMs": {"type": "integer", "minimum": 0, "maximum": 300000},
              "clockSource": {"type": "string", "minLength": 1},
              "sensorServiceInstanceId": {"type": "string", "minLength": 1},
              "durableSpoolSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"}
            },
            "allOf": [{
              "if": {"properties": {"clockQuality": {"const": "QUALIFIED"}}, "required": ["clockQuality"]},
              "then": {"required": ["clockMaxErrorMs", "clockSyncAgeMs"]},
              "else": {"not": {"anyOf": [{"required": ["clockMaxErrorMs"]}, {"required": ["clockSyncAgeMs"]}]}}
            }]
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {"$ref": "common-definitions.schema.json#/$defs/agentDeliveryRecord"},
            "description": "Original Agent DeliveryRecord array accepted by Sensor Agent Receiver (1..100, strictly contiguous)."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": 2}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["sensorAgentSpoolStreamId"]
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": 1}},
        "required": ["schemaVersion"]
      },
      "then": {
        "not": {"required": ["sensorAgentSpoolStreamId"]}
      }
    }
  ]
}
