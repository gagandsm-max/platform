{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/device-packs/manifest.schema.json",
  "title": "Platform Device Pack Manifest Contract",
  "description": "Structural contract for Platform Device Pack manifest schemaVersion 1.0.0. Platform semantic/security validation is additionally enforced by tools/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","packId","packVersion","name","publisher","certification","matchRules","capabilities","protocols","references","normalization","dependencies","provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packId": { "$ref": "#/$defs/packId" },
    "packVersion": { "$ref": "#/$defs/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "publisher": { "$ref": "#/$defs/publisher" },
    "certification": { "enum": ["OFFICIAL_CERTIFIED","PARTNER_VERIFIED","CUSTOMER_CUSTOM","EXPERIMENTAL"] },
    "metadata": { "$ref": "#/$defs/metadata" },
    "matchRules": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/matchRule" } },
    "capabilities": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/capability" } },
    "protocols": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/protocol" } },
    "references": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/reference" } },
    "normalization": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/normalization" } },
    "dependencies": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/dependency" } },
    "provenance": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "packId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "semver": { "type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "shortId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$" },
    "semanticKey": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9_-]*)+$" },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["type","name"],
      "properties": { "type": { "enum": ["PLATFORM","PARTNER","CUSTOMER"] }, "name": { "type": "string", "minLength": 1, "maxLength": 160 } }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string", "minLength": 1, "maxLength": 160 },
        "family": { "type": "string", "minLength": 1, "maxLength": 160 },
        "product": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "matchRule": {
      "type": "object", "additionalProperties": false, "required": ["ruleId","priority","conditions"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/shortId" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "conditions": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/matchCondition" } }
      }
    },
    "matchCondition": {
      "type": "object", "additionalProperties": false, "required": ["field","operator","value","caseSensitive"],
      "properties": {
        "field": { "enum": ["vendor","family","product","model","platform","software","firmware","api","mib"] },
        "operator": { "enum": ["EXACT","GLOB"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 160 },
        "caseSensitive": { "type": "boolean" }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/semanticKey" },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requiresProtocols": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/protocolFamily" } }
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["family","requirement","legacy"],
      "properties": {
        "family": { "$ref": "#/$defs/protocolFamily" },
        "requirement": { "enum": ["REQUIRED","OPTIONAL"] },
        "legacy": { "type": "boolean" },
        "suggestedPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "transportModes": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["IP","UDP","TCP","TLS","HTTPS","SSH","GRPC","MTLS"] } },
        "securityModes": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "enum": ["TLS","MTLS","SSHV2","SNMPV3","KERBEROS","NEGOTIATE","NTLM","BASIC","BEARER","API_KEY","OAUTH2","PUBLIC_KEY","PASSWORD","KEYBOARD_INTERACTIVE"] } },
        "credentialProfileType": { "enum": ["SNMP","SSH","WINRM","REST","GNMI","DB","CLOUD","REDFISH"] },
        "prerequisiteCapabilities": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/semanticKey" } }
      }
    },
    "protocolFamily": { "enum": ["ICMP","SNMP","SNMP_TRAP","SYSLOG","SSH_CLI","TELNET","NETCONF","REST","RESTCONF","GNMI","GRPC","FLOW","DNS","HTTP","HTTPS","TLS","REDFISH","WINRM","CLOUD_API","OTLP","SCP","SFTP","TFTP","FTP"] },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["id","kind","provenanceId"],
      "properties": {
        "id": { "$ref": "#/$defs/shortId" },
        "kind": { "enum": ["MIB","YANG","OPENAPI","MODEL","OTHER"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "packagePath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sourceReference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "provenanceId": { "$ref": "#/$defs/shortId" }
      },
      "anyOf": [{ "required": ["packagePath"] },{ "required": ["sourceReference"] }]
    },
    "normalization": {
      "type": "object", "additionalProperties": false, "required": ["key","source","valueType","target","qualityFallback","provenanceId"],
      "properties": {
        "key": { "$ref": "#/$defs/semanticKey" },
        "source": { "$ref": "#/$defs/normalizationSource" },
        "valueType": { "enum": ["BOOLEAN","INTEGER","NUMBER","STRING","STATE"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "target": { "$ref": "#/$defs/normalizationTarget" },
        "qualityFallback": { "const": "UNKNOWN" },
        "provenanceId": { "$ref": "#/$defs/shortId" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "normalizationSource": {
      "type": "object", "additionalProperties": false, "required": ["protocol","field"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocolFamily" },
        "field": { "type": "string", "minLength": 1, "maxLength": 256 },
        "referenceId": { "$ref": "#/$defs/shortId" }
      }
    },
    "normalizationTarget": {
      "type": "object", "additionalProperties": false, "required": ["entityType"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_.-]*$" },
        "component": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "transform": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "enum": ["IDENTITY","SCALE","OFFSET"] }, "factor": { "type": "number" }, "offset": { "type": "number" } }
    },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["packId","packVersion"],
      "properties": { "packId": { "$ref": "#/$defs/packId" }, "packVersion": { "$ref": "#/$defs/semver" } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["id","sourceType","sourceReference","redistribution"],
      "properties": {
        "id": { "$ref": "#/$defs/shortId" },
        "sourceType": { "enum": ["PLATFORM_SUPPLIED","PARTNER_SUPPLIED","CUSTOMER_SUPPLIED"] },
        "sourceReference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "license": { "type": "string", "minLength": 1, "maxLength": 160 },
        "redistribution": { "enum": ["ALLOWED","RESTRICTED","UNKNOWN"] }
      }
    }
  }
}
