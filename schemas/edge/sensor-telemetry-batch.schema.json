{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/edge/sensor-telemetry-batch.schema.json",
  "title": "Sensor→Core Telemetry Batch v1",
  "description": "CURRENT_IMPLEMENTED_V1 TelemetryBatchRequest field shape (max 1000 records; each record requires sequence). bootEpoch=stream id. Sequence ceiling FROZEN_BUILD_000_INVARIANT; runtime ceiling enforcement BUILD_003_TARGET.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sensorId", "bootEpoch", "batchId", "firstSequence", "lastSequence", "checksum", "records"],
  "properties": {
    "schemaVersion": {"$ref": "common-definitions.schema.json#/$defs/schemaVersionV1"},
    "sensorId": {"$ref": "common-definitions.schema.json#/$defs/sensorId"},
    "bootEpoch": {"$ref": "common-definitions.schema.json#/$defs/sensorStreamId"},
    "batchId": {"$ref": "common-definitions.schema.json#/$defs/coreBatchId"},
    "firstSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "lastSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "checksum": {"$ref": "common-definitions.schema.json#/$defs/checksumSha256Hex"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["sequence"],
        "properties": {
          "sequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"}
        },
        "additionalProperties": true,
        "description": "Transport requires sequence; observation payload families remain open beyond BUILD-000 envelope freeze."
      }
    }
  }
}
