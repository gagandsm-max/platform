{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_agents/schemas/task_manifest.schema.json",
  "title": "Platform Control Plane Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "authoritativeMain",
    "exactHead",
    "selectedAgents",
    "selectedSkills",
    "dependencies",
    "requiredEvidence",
    "writer",
    "verifier",
    "gatekeeper",
    "state"
  ],
  "properties": {
    "taskId": {"type": "string", "minLength": 1},
    "authoritativeMain": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "exactHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selectedAgents": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selectedSkills": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "securityBoundaries": {"type": "array", "items": {"type": "string"}},
    "migrationReservations": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "requiredTests": {"type": "array", "items": {"type": "string"}},
    "requiredEvidence": {"type": "array", "items": {"type": "string"}},
    "writer": {"type": ["string", "null"]},
    "verifier": {"type": ["string", "null"]},
    "gatekeeper": {"type": ["string", "null"]},
    "claimTypes": {
      "type": "array",
      "items": {"enum": ["SOURCE_FACT", "EXECUTION_EVIDENCE", "CI_EVIDENCE", "INFERENCE", "UNVERIFIED"]},
      "uniqueItems": true
    },
    "state": {"type": "string"}
  }
}
