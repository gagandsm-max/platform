    "IMPLEMENTATION": ["LOCAL_VALIDATION", "DIAGNOSIS", "ROUTING", "BLOCKED", "REJECTED"],
    "LOCAL_VALIDATION": ["SOURCE_REVIEW", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "SOURCE_REVIEW": ["ADVERSARIAL_RUNTIME", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "ADVERSARIAL_RUNTIME": ["SECURITY_DOMAIN_REVIEW", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "SECURITY_DOMAIN_REVIEW": ["CI_VALIDATION", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "CI_VALIDATION": ["REALITY_GATE", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "REALITY_GATE": ["MERGE_READY", "IMPLEMENTATION", "BLOCKED", "REJECTED"],
    "MERGE_READY": ["POST_MERGE_VERIFY", "BLOCKED", "REJECTED"],
    "POST_MERGE_VERIFY": ["COMPLETE", "BLOCKED", "REJECTED"],
    "COMPLETE": [],
    "BLOCKED": [
