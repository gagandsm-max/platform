{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.invalid/schemas/edge/agent-telemetry-batch.schema.json",
  "title": "Agent→Sensor Telemetry Delivery Envelope v1",
  "description": "CURRENT_IMPLEMENTED_V1 Agent DeliveryEnvelope. No entityId. No agentStreamId (BUILD_002_TARGET).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentId", "tenantId", "correlationId", "batchId", "firstSequence", "lastSequence", "recordCount", "records"],
  "properties": {
    "schemaVersion": {"$ref": "common-definitions.schema.json#/$defs/schemaVersionV1"},
    "agentId": {"$ref": "common-definitions.schema.json#/$defs/agentId"},
    "tenantId": {"$ref": "common-definitions.schema.json#/$defs/tenantId"},
    "siteId": {"$ref": "common-definitions.schema.json#/$defs/siteId"},
    "correlationId": {"$ref": "common-definitions.schema.json#/$defs/correlationId"},
    "batchId": {"$ref": "common-definitions.schema.json#/$defs/batchId"},
    "firstSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "lastSequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
    "recordCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "id", "createdAt", "checksum", "payload"],
        "properties": {
          "sequence": {"$ref": "common-definitions.schema.json#/$defs/sequenceInteger"},
          "id": {"$ref": "common-definitions.schema.json#/$defs/opaqueRecordId"},
          "createdAt": {"$ref": "common-definitions.schema.json#/$defs/utcTimestamp"},
          "checksum": {"$ref": "common-definitions.schema.json#/$defs/checksumSha256Hex"},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
