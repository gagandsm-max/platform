  "rules": {
    "writerSelfCertificationProhibited": true,
    "mainOrHeadDriftBlocksStaleReview": true,
    "validationGateModes": ["REQUIRED", "NOT_APPLICABLE_WITH_EVIDENCE"],
    "mergeReadyRequiresIndependentVerification": true,
    "mergeReadyIsNotTerminal": true,
    "completeRequiresPostMergeVerify": true,
    "blockedRequiresEvidence": true,
    "rejectedRequiresEvidence": true,
    "scopeFrozenFromImplementation": true,
    "unverifiedCannotSatisfyEvidenceGate": true
