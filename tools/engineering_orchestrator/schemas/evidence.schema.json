{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering_orchestrator/evidence.schema.json",
  "title": "EngineeringOrchestratorEvidence",
  "description": "Phase 1 attestation is UNATTESTED only. Hash/state integrity ≠ evidence attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "type",
    "claim_scope",
    "head_sha",
    "result",
    "collected_at",
    "attestation"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "SOURCE",
        "LOCAL_TEST",
        "LOCAL_RUNTIME",
        "DATABASE",
        "SECURITY",
        "CI",
        "INDEPENDENT_REVIEW",
        "INFERENCE",
        "RECOMMENDATION"
      ]
    },
    "claim_scope": { "type": "string" },
    "repository": { "type": "string" },
    "branch": { "type": "string" },
    "head_sha": { "type": "string" },
    "base_sha": { "type": "string" },
    "paths": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN", "SKIPPED", "UNKNOWN", "PARTIAL"]
    },
    "command_identity": { "type": "string" },
    "exit_code": { "type": ["integer", "null"] },
    "worker_logical_identity": { "type": "string" },
    "reviewer_logical_identity": { "type": "string" },
    "ci_run_id": { "type": "string" },
    "ci_job_id": { "type": "string" },
    "reused_from_evidence_id": { "type": "string" },
    "reuse_reason": { "type": "string" },
    "collected_at": { "type": "string" },
    "attestation": { "type": "string", "enum": ["UNATTESTED"] },
    "payload_ref": { "type": "string" },
    "impact_known": { "type": "boolean" },
    "invalidated": { "type": "boolean" },
    "invalidation_reason": { "type": "string" }
  }
}
